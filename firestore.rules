rules_version = '2';

/* ==========================================================================
   KTP Events — Firestore security rules.

   What these enforce:
     • Only verified @syr.edu / @g.syr.edu accounts can read or write anything.
     • Officer status is gated on a SHA-256 passcode check against a document
       no client can read.
     • Private profile specs stay private; only the "shown" ones surface on
       public profiles.
     • Only officers create, edit, cancel or delete events (recurring-series
       instance creation is the one narrow exception, and only if the instance
       is a faithful copy of the template with no RSVPs).
     • You can only write your own RSVP.
   ========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* -------------------------------- helpers ------------------------------- */

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Chapter gate. Keep in sync with ALLOWED_EMAIL_DOMAINS in js/config.js.
    // email_verified matters: without it anyone can register an @syr.edu
    // address they don't own and pass the domain check.
    function isMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@(g[.])?syr[.]edu$');
    }

    function isOfficer() {
      return isMember() &&
        exists(/databases/$(database)/documents/officerClaims/$(request.auth.uid));
    }

    function officerCodeHash() {
      return get(/databases/$(database)/documents/config/officer).data.codeHash;
    }

    function template(sid) {
      return get(/databases/$(database)/documents/series/$(sid)).data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* --- RSVP tallies ---
       events.counts is a denormalised count of the rsvps subcollection. A
       member's change to the counts and to their own RSVP must land in the
       same transaction (store.js setRsvp) and agree with each other; checked
       from both documents' sides, so neither can be written alone. Without
       this, +1 on counts could be repeated forever, or an RSVP deleted
       without the matching -1 and re-created for another +1. */

    function eventDoc(eid) {
      return /databases/$(database)/documents/events/$(eid);
    }

    function myRsvpDoc(eid) {
      return /databases/$(database)/documents/events/$(eid)/rsvps/$(request.auth.uid);
    }

    function rsvpBefore(eid) {
      return exists(myRsvpDoc(eid)) ? get(myRsvpDoc(eid)).data.status : null;
    }

    function rsvpAfter(eid) {
      return existsAfter(myRsvpDoc(eid)) ? getAfter(myRsvpDoc(eid)).data.status : null;
    }

    function one(status, key) {
      return status == key ? 1 : 0;
    }

    function tallyMatchesMyRsvp(eid) {
      let before = get(eventDoc(eid)).data.counts;
      let after = getAfter(eventDoc(eid)).data.counts;
      let prev = rsvpBefore(eid);
      let next = rsvpAfter(eid);
      return prev != next
        && after.keys().hasOnly(['going', 'deciding'])
        && after.going == before.going + one(next, 'going') - one(prev, 'going')
        && after.deciding == before.deciding + one(next, 'deciding') - one(prev, 'deciding');
    }

    /* --- Series instance dates ---
       store.js keys instances by the creating browser's local date, which can
       be a day either side of the UTC date of startAt. */

    function pad2(n) {
      return (n < 10 ? '0' : '') + string(n);
    }

    function ymd(t) {
      return string(t.year()) + pad2(t.month()) + pad2(t.day());
    }

    /* ------------------------- config: server-side only ------------------------ */
    /* Holds the officer passcode hash. get() inside rules bypasses these rules,
       so the comparison below still works while clients see nothing. */

    match /config/{doc} {
      allow read, write: if false;
    }

    /* ----------------------- officer claims: write-only ---------------------- */
    /* The plaintext passcode never leaves the browser — only its SHA-256. A wrong
       passcode simply fails to satisfy the rule and comes back permission-denied. */

    match /officerClaims/{uid} {
      allow read:   if false;
      allow create: if isMember()
                    && request.auth.uid == uid
                    && request.resource.data.hash is string
                    && request.resource.data.hash == officerCodeHash();
      allow update: if false;
      allow delete: if isMember() && request.auth.uid == uid;   // step down
    }

    /* ------------------------------ public profiles ---------------------------- */

    match /users/{uid} {
      allow read: if isMember();

      allow create: if isMember()
                    && request.auth.uid == uid
                    && request.resource.data.isOfficer == false;

      // isOfficer may only become true if this account holds a verified claim.
      allow update: if isMember()
                    && request.auth.uid == uid
                    && (request.resource.data.isOfficer == false || isOfficer());

      allow delete: if false;
    }

    /* --------------------------- private specifications ------------------------ */
    /* Owner reads/writes their own. Officers may read everyone's — that's what
       backs the aggregate planning counts for people who kept a badge private.
       Officers cannot write someone else's specs. */

    match /userSpecs/{uid} {
      allow read:  if isMember() && (request.auth.uid == uid || isOfficer());
      allow write: if isMember() && request.auth.uid == uid;
    }

    /* --------------------------------- events -------------------------------- */

    match /events/{eventId} {

      // A member's browser may materialise the next occurrence of an active
      // series, but only as a faithful copy of the template with no RSVPs.
      // The doc ID must be the deterministic s-<seriesId>-<yyyymmdd> the client
      // generates (store.js ensureSeriesInstances). Left unconstrained, a member
      // could pick an ID containing markup.
      function validSeriesInstance() {
        let d = request.resource.data;
        let day = duration.value(1, 'd');
        return isMember()
          && d.seriesId is string
          && d.seriesId.matches('^[A-Za-z0-9]+$')
          && eventId.matches('^s-' + d.seriesId + '-[0-9]{8}$')
          // Exactly the fields ensureSeriesInstances() writes — no featured,
          // target, drivers or anything else riding along.
          && d.keys().hasOnly(['title', 'description', 'location', 'category',
               'startAt', 'endAt', 'threshold', 'decisionDeadline', 'photoUrl',
               'seriesId', 'override', 'outcome', 'outcomeNote', 'counts',
               'attendance', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
          && d.startAt is timestamp
          && d.endAt is timestamp
          && d.decisionDeadline is timestamp
          // The date in the ID has to be this instance's own date, so nobody can
          // park a doc on a future date and block the real one from generating.
          && eventId in ['s-' + d.seriesId + '-' + ymd(d.startAt),
                         's-' + d.seriesId + '-' + ymd(d.startAt - day),
                         's-' + d.seriesId + '-' + ymd(d.startAt + day)]
          // Generation looks from today to seriesHorizonDays (35, js/config.js)
          // ahead; two days' slack either side.
          && d.startAt > request.time - day
          && d.startAt < request.time + duration.value(37, 'd')
          && d.endAt > d.startAt
          && d.decisionDeadline <= d.startAt
          && d.createdAt == request.time
          && d.updatedAt == request.time
          && d.outcomeNote == ''
          && d.counts.keys().hasOnly(['going', 'deciding'])
          && exists(/databases/$(database)/documents/series/$(request.resource.data.seriesId))
          && d.description == template(d.seriesId).get('description', '')
          && d.createdBy == template(d.seriesId).get('createdBy', request.auth.uid)
          && d.createdByName == template(d.seriesId).get('createdByName', '')
          && template(request.resource.data.seriesId).paused == false
          && request.resource.data.title     == template(request.resource.data.seriesId).title
          && request.resource.data.location  == template(request.resource.data.seriesId).location
          && request.resource.data.category  == template(request.resource.data.seriesId).category
          && request.resource.data.threshold == template(request.resource.data.seriesId).threshold
          // .get(field, default) on BOTH sides, not direct access. Series
          // templates created before photoUrl existed have no such key, and
          // direct access on a missing key is an error — which would deny the
          // create and silently stop every pre-existing series from generating.
          && request.resource.data.get('photoUrl', null)
             == template(request.resource.data.seriesId).get('photoUrl', null)
          && request.resource.data.override  == null
          && request.resource.data.outcome   == null
          && request.resource.data.attendance == null
          && request.resource.data.counts.going == 0
          && request.resource.data.counts.deciding == 0;
      }

      // Members may only touch the denormalised RSVP tallies, never below zero,
      // and only alongside the matching change to their own RSVP.
      function countsOnly() {
        return changedKeys().hasOnly(['counts'])
          && request.resource.data.counts.going >= 0
          && request.resource.data.counts.deciding >= 0
          && tallyMatchesMyRsvp(eventId);
      }

      allow read:   if isMember();
      // Officers too: one-off events use auto-IDs, instances use the pattern
      // above, so nothing legitimate needs characters outside this set.
      allow create: if eventId.matches('^[A-Za-z0-9_-]{1,100}$')
                    && (isOfficer() || validSeriesInstance());
      allow update: if isOfficer() || (isMember() && countsOnly());
      allow delete: if isOfficer();

      /* ---------------------------- RSVPs ---------------------------- */
      /* Name-attached by design: everyone can see who's Going and who's Still
         Deciding. You can only write your own. */

      match /rsvps/{uid} {
        allow read: if isMember();

        allow create, update: if isMember()
                              && request.auth.uid == uid
                              && request.resource.data.keys().hasOnly(['uid', 'status', 'updatedAt'])
                              && request.resource.data.uid == uid
                              && request.resource.data.status in ['going', 'deciding']
                              && request.resource.data.updatedAt == request.time
                              && tallyMatchesMyRsvp(eventId);

        // Officers clear RSVPs wholesale when deleting an event (deleteEvent),
        // so theirs skips the tally check.
        allow delete: if isOfficer()
                      || (isMember() && request.auth.uid == uid && tallyMatchesMyRsvp(eventId));
      }
    }

    /* ---------------------------- recurring templates -------------------------- */

    match /series/{seriesId} {
      allow read:  if isMember();
      allow write: if isOfficer();
    }

    /* ------------------------------- catch-all -------------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
